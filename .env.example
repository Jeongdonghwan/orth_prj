# ---- Flask ----
FLASK_ENV=production
SECRET_KEY=
SITE_URL=http://localhost:5000

# ---- DB (둘 중 하나) ----
# 1) 한 줄로 지정
DATABASE_URL=mysql+pymysql://user:pw@localhost/ortho
# 2) 또는 분리 지정 (DATABASE_URL 비어 있을 때 사용). 둘 다 비어 있으면 instance/ortho.sqlite 로 동작
DB_HOST=localhost
DB_PORT=3306
DB_NAME=
DB_USER=
DB_PASSWORD=

# ---- 카카오맵 ----
KAKAO_JS_KEY=
CLINIC_LAT=
CLINIC_LNG=

# ---- 관리자 (/admin/inquiries, Basic Auth). ADMIN_PW 비어 있으면 관리자 페이지 잠김 ----
ADMIN_ID=admin
ADMIN_PW=

# ---- SEO ----
NAVER_SITE_VERIFICATION=

# ---- 병원 부가 정보 (선택) ----
CLINIC_EMAIL=
CLINIC_BLOG_URL=

# ---- 문의 접수 메일 발송 (선택, SMTP_HOST 비면 발송 생략) ----
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
